# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it's already covered by .gitignore below,
# but double check before pushing.

# Your wallet's private key (the account that will pay gas and deploy the
# contract). Get Sepolia test ETH from a faucet like sepoliafaucet.com or
# Alchemy's faucet — you'll need a small amount to cover gas.
PRIVATE_KEY=

# A Sepolia RPC endpoint. Free options: Alchemy (alchemy.com), Infura
# (infura.io), or a public RPC like https://rpc.sepolia.org
SEPOLIA_RPC_URL=

# Optional — only needed if you want `--verify` to auto-verify the contract
# source on Etherscan. Get a free API key at etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional — the contribution amount per round, in the token's smallest unit.
# Defaults to 100 * 10^18 (i.e. "100 tokens" for an 18-decimal token) if unset.
CONTRIBUTION_AMOUNT=

# Optional — an existing ERC20 token address to use for contributions. If
# left blank, the deploy script deploys a fresh MockToken on Sepolia for you
# to test with.
TOKEN_ADDRESS=
